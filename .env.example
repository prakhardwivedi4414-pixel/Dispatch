# The Dispatch — Environment Configuration
# Copy this file to .env and provide your managed Supabase credentials for production database persistence.
# If omitted or left as placeholder, The Dispatch automatically operates in Local Demo Storage mode.

# Supabase API URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Public Key (Project Settings -> API -> Project API Keys -> anon / public)
# IMPORTANT: NEVER place secret service_role keys here!
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
